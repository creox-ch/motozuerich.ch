{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "image-slot.js",
              "mz-chrome.js",
              "mz-head.js",
              "mz-page.js",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Sans|IBM Plex Mono|Nunito Sans))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Sans, IBM Plex Mono, Nunito Sans."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--action-yellow",
      "--bg",
      "--bg-alt",
      "--brand",
      "--brand-dark",
      "--brand-darker",
      "--brand-light",
      "--brand-soft",
      "--fg",
      "--font-body",
      "--font-display",
      "--font-mono",
      "--fs-body",
      "--fs-claim",
      "--fs-h1",
      "--fs-h2",
      "--fs-h3",
      "--fs-hero",
      "--fs-label",
      "--fs-lead",
      "--fs-meta",
      "--fs-stat",
      "--line",
      "--line-strong",
      "--muted",
      "--night",
      "--night-soft",
      "--swiss-red",
      "--swiss-red-dark",
      "--tracking-cta",
      "--tracking-label",
      "--tracking-tag",
      "--tracking-tight"
    ],
    "tokenKinds": {
      "--brand": "color",
      "--brand-dark": "color",
      "--brand-darker": "color",
      "--brand-light": "color",
      "--brand-soft": "color",
      "--night": "color",
      "--night-soft": "color",
      "--bg": "color",
      "--bg-alt": "color",
      "--fg": "color",
      "--muted": "color",
      "--line": "color",
      "--line-strong": "color",
      "--swiss-red": "color",
      "--swiss-red-dark": "color",
      "--action-yellow": "color",
      "--font-display": "font",
      "--font-mono": "font",
      "--font-body": "font",
      "--fs-hero": "font",
      "--fs-claim": "font",
      "--fs-h1": "font",
      "--fs-h2": "font",
      "--fs-h3": "spacing",
      "--fs-stat": "font",
      "--fs-lead": "font",
      "--fs-body": "spacing",
      "--fs-label": "spacing",
      "--fs-meta": "spacing",
      "--tracking-label": "font",
      "--tracking-cta": "font",
      "--tracking-tag": "font",
      "--tracking-tight": "font"
    },
    "fontFamilies": [
      "IBM Plex Mono",
      "IBM Plex Sans",
      "Nunito Sans"
    ]
  }
}